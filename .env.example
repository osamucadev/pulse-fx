# PostgreSQL (usado pelo docker-compose para subir o serviço postgres)
POSTGRES_USER=pulsefx
POSTGRES_PASSWORD=pulsefx
POSTGRES_DB=pulsefx

# Usado pelo backend quando rodado fora do Docker Compose (ex.: npm run dev)
# Dentro do Docker Compose, o backend recebe DATABASE_URL apontando para o host "postgres" automaticamente.
DATABASE_URL=postgresql://pulsefx:pulsefx@localhost:5432/pulsefx?schema=public
